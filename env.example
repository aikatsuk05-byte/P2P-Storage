import React, { useState, useEffect } from 'react';
import { 
  Wifi, 
  WifiOff, 
  Bluetooth, 
  Settings, 
  Folder, 
  Activity, 
  Home, 
  Check, 
  Battery, 
  Signal, 
  ChevronDown, 
  Info,
  Layers, 
  SlidersHorizontal,
  ChevronLeft,
  Square,
  Circle,
  Play,
  RotateCcw,
  Zap
} from 'lucide-react';
import { DeviceState, P2PConnection, SimulatedFile, AndroidApp } from '../types';
import { 
  FileExplorer, 
  P2PNegotiator, 
  SysMonitor, 
  SystemSettings 
} from './SystemApps';
import { motion, AnimatePresence } from 'motion/react';

interface PhoneMockupProps {
  device: DeviceState;
  peerDevice: DeviceState;
  connection: P2PConnection;
  onUpdateFiles: (deviceId: DeviceState['id'], files: SimulatedFile[]) => void;
  onUpdateP2P: (updates: Partial<P2PConnection>) => void;
  onTriggerTransfer: (
    file: SimulatedFile, 
    sourceId: DeviceState['id'], 
    destId: DeviceState['id'],
    onComplete: () => void
  ) => void;
  onSetOpenApp: (deviceId: DeviceState['id'], app: AndroidApp) => void;
  onSetWallpaper: (deviceId: DeviceState['id'], index: number) => void;
  onToggleP2PSubsystems: (deviceId: DeviceState['id'], subsystem: 'ble' | 'wifi') => void;
  onTriggerNegotiation: () => void;
  pasteboard: SimulatedFile | null;
  onSetPasteboard: (file: SimulatedFile | null) => void;
}

export const PhoneMockup: React.FC<PhoneMockupProps> = ({
  device,
  peerDevice,
  connection,
  onUpdateFiles,
  onUpdateP2P,
  onTriggerTransfer,
  onSetOpenApp,
  onSetWallpaper,
  onToggleP2PSubsystems,
  onTriggerNegotiation,
  pasteboard,
  onSetPasteboard,
}) => {
  const [time, setTime] = useState('12:00');
  const [isShadeOpen, setIsShadeOpen] = useState(false);

  // Background wallpapers matching SystemApps.tsx choices with Immersive UI styling
  const wallpapers = [
    'linear-gradient(135deg, #0c0d14 0%, #040508 100%)', // Midnight Obsidian
    'linear-gradient(135deg, #060e0a 0%, #020403 100%)', // Emerald Void
    'linear-gradient(135deg, #0f0918 0%, #040206 100%)', // Cosmic Violet
    'linear-gradient(135deg, #0d0d0d 0%, #030303 100%)', // Pure Charcoal
  ];

  useEffect(() => {
    const updateTime = () => {
      const now = new Date();
      let hours = now.getHours().toString().padStart(2, '0');
      let minutes = now.getMinutes().toString().padStart(2, '0');
      setTime(`${hours}:${minutes}`);
    };
    updateTime();
    const timer = setInterval(updateTime, 1000);
    return () => clearInterval(timer);
  }, []);

  const handleAppClick = (app: AndroidApp) => {
    onSetOpenApp(device.id, app);
  };

  const currentWallpaper = wallpapers[device.wallpaperIndex] || wallpapers[0];

  return (
    <div className="flex flex-col items-center select-none" id={`phone-chassis-${device.id}`}>
      {/* Device Name Banner */}
      <div className="mb-3 text-center">
        <span className="text-xs font-black text-white/55 font-mono flex items-center gap-2 justify-center tracking-wider uppercase bg-white/5 px-3 py-1.5 rounded-full border border-white/5">
          <span className={`w-2.5 h-2.5 rounded-full ring-2 ring-black ${device.id === 'phone-alpha' ? 'bg-[#3ddc84]' : 'bg-[#4285f4]'}`} />
          {device.modelName} &nbsp;(<span className={device.id === 'phone-alpha' ? 'text-[#3ddc84]' : 'text-[#4285f4]'}>{device.id === 'phone-alpha' ? 'Alpha Node' : 'Beta Node'}</span>)
        </span>
      </div>

      {/* Styled Physical Phone Body */}
      <div className="relative w-[345px] h-[670px] bg-black rounded-[44px] p-2.5 shadow-2xl border-[4px] border-white/10 ring-[6px] ring-black/40 flex flex-col overflow-hidden transition-all duration-300 hover:border-[#3ddc84]/30">
        
        {/* Dynamic Notch/Hole Punch */}
        <div className="absolute top-4 left-1/2 transform -translate-x-1/2 w-28 h-5.5 bg-black rounded-full z-50 flex items-center justify-between px-3.5 border border-white/5">
          <div className="w-2.5 h-2.5 bg-neutral-900 rounded-full border border-neutral-800" /> {/* Camera */}
          <div className="w-10 h-1 bg-neutral-900 rounded-full" /> {/* Speaker */}
        </div>

        {/* Outer screen element with wallpaper background */}
        <div 
          className="relative flex-grow rounded-[34px] overflow-hidden flex flex-col text-white transition-all duration-300"
          style={{ background: currentWallpaper }}
        >
          {/* Status Bar */}
          <div 
            onClick={() => setIsShadeOpen(!isShadeOpen)}
            className="h-9 px-6 pt-2 bg-gradient-to-b from-black/60 to-transparent flex justify-between items-center z-40 text-[11px] font-medium tracking-tight cursor-pointer"
          >
            <span className="font-semibold font-mono text-white/95">{time}</span>
            <div className="flex items-center gap-2">
              {device.bleEnabled && (
                <Bluetooth className="w-3.2 h-3.2 text-[#3ddc84] stroke-[2.5]" />
              )}
              {connection.status === 'connected' ? (
                <div className="flex items-center gap-0.5">
                  <span className="text-[9px] font-mono text-[#3ddc84] font-bold mr-0.5">P2P</span>
                  <Wifi className="w-3.2 h-3.2 text-[#3ddc84]" />
                </div>
              ) : device.wifiDirectEnabled ? (
                <Wifi className="w-3.2 h-3.2 text-amber-400" />
              ) : (
                <WifiOff className="w-3.2 h-3.2 text-white/40" />
              )}
              <Signal className="w-3.2 h-3.2 text-white/60" />
              <div className="flex items-center gap-0.5 font-mono text-[9px] text-white/95 font-bold">
                <span>{device.battery}%</span>
                <Battery className="w-3.5 h-3.5 stroke-[1.8]" />
              </div>
            </div>
          </div>

          {/* Core App screen switcher */}
          <div className="flex-1 overflow-hidden relative">
            <AnimatePresence mode="wait">
              {device.openApp === 'home' && (
                <motion.div 
                  key="home"
                  initial={{ opacity: 0, scale: 0.96 }}
                  animate={{ opacity: 1, scale: 1 }}
                  exit={{ opacity: 0, scale: 0.96 }}
                  transition={{ duration: 0.15 }}
                  className="h-full flex flex-col p-5 space-y-6"
                >
                  {/* Dynamic Weather / P2P Quick Status Widget */}
                  <div className="p-4 rounded-3xl bg-black/55 border border-white/10 backdrop-blur-md space-y-2.5">
                    <div className="flex justify-between items-start">
                      <div>
                        <span className="text-[10px] text-[#3ddc84] font-mono tracking-widest uppercase font-black">Local-Grid P2P</span>
                        <h3 className="text-sm font-bold mt-0.5 tracking-tight font-display">Stockage Partagé</h3>
                      </div>
                      <Zap className={`w-5 h-5 ${connection.status === 'connected' ? 'text-[#3ddc84] animate-pulse' : 'text-white/20'}`} />
                    </div>
                    
                    <div className="pt-1.5 flex justify-between items-center text-xs">
                      <div className="flex flex-col">
                        <span className="text-[9px] text-white/50 uppercase font-mono tracking-wider">Statut Réseau</span>
                        <span className="font-bold text-white">
                          {connection.status === 'connected' ? 'Partition Active' : 'Déconnecté'}
                        </span>
                      </div>
                      <div className="flex flex-col text-right">
                        <span className="text-[9px] text-white/50 uppercase font-mono tracking-wider">Vitesse Directe</span>
                        <span className="font-mono text-[#3ddc84] font-black">
                          {connection.status === 'connected' ? `${connection.speedMbps} Mo/s` : '---'}
                        </span>
                      </div>
                    </div>

                    {connection.status !== 'connected' && (
                      <button
                        onClick={() => handleAppClick('p2p-negotiator')}
                        className="w-full py-2 mt-2 rounded-xl bg-[#3ddc84] hover:bg-[#3ddc84]/90 text-black font-black text-[10px] uppercase tracking-wider font-mono transition"
                        id={`widget-link-btn-${device.id}`}
                      >
                        Négociation WiFi P2P
                      </button>
                    )}
                  </div>

                  {/* App Grid */}
                  <div className="flex-1 grid grid-cols-3 gap-y-6 pt-3">
                    {/* App 1: Files */}
                    <div 
                      onClick={() => handleAppClick('file-explorer')}
                      className="flex flex-col items-center gap-1.5 cursor-pointer text-center group"
                      id={`icon-explorer-${device.id}`}
                    >
                      <div className="w-13 h-13 rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 shadow-md border border-blue-400/25 flex items-center justify-center p-3 group-hover:scale-105 transition-all">
                        <Folder className="w-7 h-7 text-white fill-white/10" />
                      </div>
                      <span className="text-[10px] font-semibold text-neutral-200 tracking-tight text-shadow-sm">Fichiers</span>
                    </div>

                    {/* App 2: WiFi Negotiator */}
                    <div 
                      onClick={() => handleAppClick('p2p-negotiator')}
                      className="flex flex-col items-center gap-1.5 cursor-pointer text-center group"
                      id={`icon-p2p-${device.id}`}
                    >
                      <div className="w-13 h-13 rounded-2xl bg-gradient-to-br from-teal-400 to-emerald-500 shadow-md border border-teal-300/30 flex items-center justify-center p-3 group-hover:scale-105 transition-all">
                        <Zap className="w-7 h-7 text-neutral-950 font-bold" />
                      </div>
                      <span className="text-[10px] font-semibold text-neutral-200 tracking-tight">WiFi-Direct</span>
                    </div>

                    {/* App 3: Sys Monitor */}
                    <div 
                      onClick={() => handleAppClick('sys-monitor')}
                      className="flex flex-col items-center gap-1.5 cursor-pointer text-center group"
                      id={`icon-monitor-${device.id}`}
                    >
                      <div className="w-13 h-13 rounded-2xl bg-gradient-to-br from-violet-500 to-fuchsia-600 shadow-md border border-violet-400/25 flex items-center justify-center p-3 group-hover:scale-105 transition-all">
                        <Activity className="w-7 h-7 text-white" />
                      </div>
                      <span className="text-[10px] font-semibold text-neutral-200 tracking-tight">Moniteur P2P</span>
                    </div>

                    {/* App 4: Settings */}
                    <div 
                      onClick={() => handleAppClick('settings')}
                      className="flex flex-col items-center gap-1.5 cursor-pointer text-center group"
                      id={`icon-settings-${device.id}`}
                    >
                      <div className="w-13 h-13 rounded-2xl bg-gradient-to-br from-stone-600 to-neutral-800 shadow-md border border-neutral-500/20 flex items-center justify-center p-3 group-hover:scale-105 transition-all">
                        <Settings className="w-7 h-7 text-neutral-200" />
                      </div>
                      <span className="text-[10px] font-semibold text-neutral-200 tracking-tight">Paramètres</span>
                    </div>
                  </div>

                  {/* Smart Bottom Dock Bar */}
                  <div className="p-3 bg-neutral-950/45 border border-white/5 backdrop-blur-lg rounded-3xl grid grid-cols-3 gap-2">
                    <div onClick={() => handleAppClick('file-explorer')} className="p-2 flex flex-col items-center hover:scale-105 cursor-pointer">
                      <Folder className="w-5.5 h-5.5 text-neutral-200 fill-neutral-200/5" />
                    </div>
                    <div onClick={() => handleAppClick('p2p-negotiator')} className="p-2 flex flex-col items-center hover:scale-105 cursor-pointer">
                      <Zap className="w-5.5 h-5.5 text-amber-400" />
                    </div>
                    <div onClick={() => handleAppClick('settings')} className="p-2 flex flex-col items-center hover:scale-105 cursor-pointer">
                      <Settings className="w-5.5 h-5.5 text-neutral-200" />
                    </div>
                  </div>
                </motion.div>
              )}

              {device.openApp === 'file-explorer' && (
                <motion.div 
                  key="file-explorer"
                  initial={{ opacity: 0, x: 15 }}
                  animate={{ opacity: 1, x: 0 }}
                  exit={{ opacity: 0, x: -15 }}
                  className="h-full"
                >
                  <FileExplorer
                    device={device}
                    peerDevice={peerDevice}
                    connection={connection}
                    onUpdateFiles={onUpdateFiles}
                    onUpdateP2P={onUpdateP2P}
                    onTriggerTransfer={onTriggerTransfer}
                    onSetOpenApp={(app) => onSetOpenApp(device.id, app)}
                    onSetWallpaper={(idx) => onSetWallpaper(device.id, idx)}
                    onToggleP2PSubsystems={(sub) => onToggleP2PSubsystems(device.id, sub)}
                    onTriggerNegotiation={onTriggerNegotiation}
                    pasteboard={pasteboard}
                    onSetPasteboard={onSetPasteboard}
                  />
                </motion.div>
              )}

              {device.openApp === 'p2p-negotiator' && (
                <motion.div 
                  key="p2p-negotiator"
                  initial={{ opacity: 0, x: 15 }}
                  animate={{ opacity: 1, x: 0 }}
                  exit={{ opacity: 0, x: -15 }}
                  className="h-full"
                >
                  <P2PNegotiator
                    device={device}
                    peerDevice={peerDevice}
                    connection={connection}
                    onUpdateFiles={onUpdateFiles}
                    onUpdateP2P={onUpdateP2P}
                    onTriggerTransfer={onTriggerTransfer}
                    onSetOpenApp={(app) => onSetOpenApp(device.id, app)}
                    onSetWallpaper={(idx) => onSetWallpaper(device.id, idx)}
                    onToggleP2PSubsystems={(sub) => onToggleP2PSubsystems(device.id, sub)}
                    onTriggerNegotiation={onTriggerNegotiation}
                    pasteboard={pasteboard}
                    onSetPasteboard={onSetPasteboard}
                  />
                </motion.div>
              )}

              {device.openApp === 'sys-monitor' && (
                <motion.div 
                  key="sys-monitor"
                  initial={{ opacity: 0, x: 15 }}
                  animate={{ opacity: 1, x: 0 }}
                  exit={{ opacity: 0, x: -15 }}
                  className="h-full"
                >
                  <SysMonitor
                    device={device}
                    peerDevice={peerDevice}
                    connection={connection}
                    onUpdateFiles={onUpdateFiles}
                    onUpdateP2P={onUpdateP2P}
                    onTriggerTransfer={onTriggerTransfer}
                    onSetOpenApp={(app) => onSetOpenApp(device.id, app)}
                    onSetWallpaper={(idx) => onSetWallpaper(device.id, idx)}
                    onToggleP2PSubsystems={(sub) => onToggleP2PSubsystems(device.id, sub)}
                    onTriggerNegotiation={onTriggerNegotiation}
                    pasteboard={pasteboard}
                    onSetPasteboard={onSetPasteboard}
                  />
                </motion.div>
              )}

              {device.openApp === 'settings' && (
                <motion.div 
                  key="settings"
                  initial={{ opacity: 0, x: 15 }}
                  animate={{ opacity: 1, x: 0 }}
                  exit={{ opacity: 0, x: -15 }}
                  className="h-full"
                >
                  <SystemSettings
                    device={device}
                    peerDevice={peerDevice}
                    connection={connection}
                    onUpdateFiles={onUpdateFiles}
                    onUpdateP2P={onUpdateP2P}
                    onTriggerTransfer={onTriggerTransfer}
                    onSetOpenApp={(app) => onSetOpenApp(device.id, app)}
                    onSetWallpaper={(idx) => onSetWallpaper(device.id, idx)}
                    onToggleP2PSubsystems={(sub) => onToggleP2PSubsystems(device.id, sub)}
                    onTriggerNegotiation={onTriggerNegotiation}
                    pasteboard={pasteboard}
                    onSetPasteboard={onSetPasteboard}
                  />
                </motion.div>
              )}
            </AnimatePresence>
          </div>

          {/* Quick Settings Pull-Down Shade Notification Drawer Overlay */}
          <AnimatePresence>
            {isShadeOpen && (
              <motion.div
                initial={{ y: '-100%' }}
                animate={{ y: 0 }}
                exit={{ y: '-100%' }}
                transition={{ type: 'spring', damping: 25, stiffness: 220 }}
                className="absolute inset-x-0 top-0 max-h-[85%] bg-neutral-950/95 border-b border-neutral-800 rounded-b-[30px] z-50 p-5 pt-10 text-xs flex flex-col space-y-4 shadow-2xl backdrop-blur-md"
              >
                {/* Pull up Handle indicator */}
                <div 
                  onClick={() => setIsShadeOpen(false)}
                  className="absolute bottom-2.5 left-1/2 -translate-x-1/2 w-14 h-1.5 bg-neutral-700/60 rounded-full cursor-pointer hover:bg-neutral-500" 
                />

                <div className="flex justify-between items-center text-neutral-400 font-mono text-[10px]">
                  <span>P2P CONTROL CENTER</span>
                  <span>Canal Direct wlan1</span>
                </div>

                {/* Grid of Quick Toggle Buttons */}
                <div className="grid grid-cols-2 gap-3 pt-1">
                  
                  {/* Bluetooth Button */}
                  <div 
                    onClick={() => onToggleP2PSubsystems(device.id, 'ble')}
                    className={`p-3 rounded-2xl flex flex-col gap-1.5 border cursor-pointer transition ${
                      device.bleEnabled 
                        ? 'bg-[#4285f4] text-black border-[#4285f4]' 
                        : 'bg-white/5 text-white/40 border-white/5'
                    }`}
                  >
                    <div className="flex justify-between items-center">
                      <Bluetooth className="w-4 h-4" />
                      <span className="text-[9px] font-mono leading-none font-bold uppercase">
                        {device.bleEnabled ? 'Activé' : 'Désactivé'}
                      </span>
                    </div>
                    <div>
                      <p className="font-bold text-[10px]">Découverte BLE</p>
                      <p className="text-[8px] opacity-75">Diffusion identifiant</p>
                    </div>
                  </div>

                  {/* WiFi P2P Button */}
                  <div 
                    onClick={() => onToggleP2PSubsystems(device.id, 'wifi')}
                    className={`p-3 rounded-2xl flex flex-col gap-1.5 border cursor-pointer transition ${
                      device.wifiDirectEnabled 
                        ? 'bg-[#3ddc84] text-black border-[#3ddc84]' 
                        : 'bg-white/5 text-white/40 border-white/5'
                    }`}
                  >
                    <div className="flex justify-between items-center">
                      <Wifi className="w-4 h-4" />
                      <span className="text-[9px] font-mono leading-none font-bold uppercase">
                        {device.wifiDirectEnabled ? 'Activé' : 'Désactivé'}
                      </span>
                    </div>
                    <div>
                      <p className="font-bold text-[10px]">Wi-Fi Direct</p>
                      <p className="text-[8px] opacity-75">Transmission P2P</p>
                    </div>
                  </div>
                </div>

                {/* Subsystem State Info banner */}
                <div className="bg-black/45 border border-white/5 p-3 rounded-2xl space-y-2 font-mono text-[10px]">
                  <div className="flex justify-between text-white/50">
                    <span>État de liaison</span>
                    <span className={connection.status === 'connected' ? 'text-[#3ddc84] font-bold' : 'text-amber-400'}>
                      {connection.status === 'connected' ? 'MONTE' : 'NON MONTÉ'}
                    </span>
                  </div>
                  {connection.status === 'connected' && (
                    <div className="flex justify-between text-white/50">
                      <span>Vitesse négociée</span>
                      <span className="text-white font-bold">{connection.speedMbps} Mo/s</span>
                    </div>
                  )}
                  <div className="flex justify-between text-neutral-400">
                    <span>Batterie</span>
                    <span className="text-neutral-200">{device.battery}% (Sûr)</span>
                  </div>
                </div>

                <div className="flex justify-center pb-2">
                  <button 
                    onClick={() => setIsShadeOpen(false)}
                    className="text-neutral-500 hover:text-neutral-300 text-[10px] font-semibold tracking-wider font-sans uppercase"
                  >
                    Fermer les paramètres rapides
                  </button>
                </div>
              </motion.div>
            )}
          </AnimatePresence>

          {/* Android Navigation Bar */}
          <div className="h-10 bg-black/90 flex justify-around items-center border-t border-neutral-900/60 z-40 px-8">
            {/* Back button */}
            <button 
              onClick={() => {
                if (device.openApp !== 'home') {
                  onSetOpenApp(device.id, 'home');
                }
              }}
              className="p-2 text-neutral-400 hover:text-white transition"
              title="Retour"
              id={`nav-back-${device.id}`}
            >
              <ChevronLeft className="w-5.5 h-5.5" />
            </button>
            {/* Home button */}
            <button 
              onClick={() => onSetOpenApp(device.id, 'home')}
              className="p-2 text-neutral-400 hover:text-white transition"
              title="Accueil"
              id={`nav-home-${device.id}`}
            >
              <Circle className="w-4.5 h-4.5 fill-neutral-400 stroke-2 hover:fill-white" />
            </button>
            {/* Recents/Overlay switcher */}
            <button 
              onClick={() => setIsShadeOpen(!isShadeOpen)}
              className="p-2 text-neutral-400 hover:text-white transition"
              title="Raccourcis"
              id={`nav-recents-${device.id}`}
            >
              <Square className="w-3.5 h-3.5 stroke-2" />
            </button>
          </div>

        </div>
      </div>
    </div>
  );
};
